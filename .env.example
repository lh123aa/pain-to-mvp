# =====================================================================
# The Tell — 环境变量模板
# 复制为 .env.local 后填写；本文件不含任何真实密钥，请勿把密钥写进来。
# 所有变量都是「留空 = 走 mock / no-op」，方便本地与 CI 离线跑通。
# =====================================================================

# ===== 站点地址 =====
# 公开地址（结账回跳、邮件里的按钮链接）
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 报告页魔链链接前缀（生产填 https://thetell.app）
NEXT_PUBLIC_MAGIC_BASE=http://localhost:3000
# 站点主域名（canonical / sitemap / SEO 页共用；未设置时回落到 https://thetell.app 占位）
# 域名拍板（G3）后只需改这一个值
NEXT_PUBLIC_SITE_URL=

# ===== Lemon Squeezy（真实结账）=====
# 注册：https://app.lemonsqueezy.com → Settings → API
# API Key（Test 模式可用 Test 卡片付款，不扣真钱；生产用 Live key）
LEMON_SQUEEZY_API_KEY=
# 店铺 ID（Dashboard 顶栏可见，整数，如 123456）
LEMON_SQUEEZY_STORE_ID=
# 商品 Variant ID（$14.99 一次性商品 "The Tell — Relationship Report" 的 variant id）
LEMON_SQUEEZY_VARIANT_ID=
# 结账开关：true = 真实 Lemon Squeezy 托管结账；留空 / false = mock（不发真实网络请求）
# 注意：只有 API_KEY 与 LIVE=true 同时成立才走 live
LEMON_SQUEEZY_LIVE=
# 客户端可见的同一开关（report 页要用它判断"这是 live 站点还是演示站点"）。
# 部署时请与 LEMON_SQUEEZY_LIVE 保持同值；否则 live 站点上裸访问 /report 会按演示模式渲染。
NEXT_PUBLIC_LEMON_SQUEEZY_LIVE=

# Webhook 验签（Dashboard → Settings → Webhooks → 创建 Webhook 时得到 signing secret）
# 验签口径：header `X-Signature` = HMAC-SHA256 hex(原始 request body, 该 secret)
# 未配置时 /api/webhook/lemonsqueezy 直接 500（fail closed），不会放过未验签请求
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ===== 魔链（magic link）=====
# 签发 / 验证报告页 token 的 HMAC-SHA256 密钥（token = v1.<payload>.<sig>，7 天有效）
# 生产必须设置（且与 webhook secret 分开）。未设置时依次回落：
#   1. LEMON_SQUEEZY_WEBHOOK_SECRET
#   2. 非 production 环境的开发用 fallback（会打印警告）
MAGIC_LINK_SECRET=

# ===== 交易邮件（5 封：魔链 / 收据 / 报告就绪 / 退款 / 跟进）=====
# 无 EMAIL_API_KEY 时 email 层为 no-op：不建依赖、不发网络请求
# 目前实现：resend（原生 fetch 调 https://api.resend.com/emails）
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
# 发件人，需在 Resend 验证过的域名
EMAIL_FROM=The Tell <no-reply@thetell.app>

# ===== 订单 / 报告存储（三选一，优先级：DATABASE_URL > DATA_DIR > 内存）=====
# 默认：不设任何变量 -> 进程内 Map（仅测试/本地；重启丢单）
# 文件模式：适合单实例 staging/本地长期运行；进程内串行 + 跨重启持久，但多实例仍会丢更新
# 生产（Vercel/serverless 多实例）：必须用 Postgres。
#   DATABASE_URL 非空时订单与报告都走 PgOrderStore / PgReportStore（懒加载 pg 驱动）；
#   首次部署先建表：`DATABASE_URL=postgres://... pnpm db:migrate`
#   （等价于 node scripts/migrate.mjs，读取 src/lib/sql/schema.sql，全部 IF NOT EXISTS）。
ORDERS_DATA_DIR=
DATABASE_URL=

# ===== 跨设备报告存储（W3-2）=====
# 报告只在浏览器生成后上传「ReportDataV2」（短引用，不含原文）；默认内存，重启丢报告。
# 文件模式（单实例 staging/本地）：设目录，落 <dir>/reports.json（原子写、进程内串行、
#   损坏自动备份 .corrupt-<ts>、90 天过期）。设置 DATABASE_URL 后自动走 Postgres（优先）。
REPORT_DATA_DIR=
# POST /api/report 的 24h 上传 token 签名密钥（scope=report-upload，绑定 orderId）。
# 未设置时回落到 MAGIC_LINK_SECRET；production 两者都没有 -> /api/order-status 返回 500。
# 建议单独配置，避免与魔链/退款密钥共用。
REPORT_UPLOAD_SECRET=

# ===== 埋点（PostHog EU）=====
NEXT_PUBLIC_POSTHOG_KEY=
# EU ingestion 端点（代码会把 eu.posthog.com 自动纠正为 eu.i.posthog.com）
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
