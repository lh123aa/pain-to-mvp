# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 模板文件需要进版本库（不含密钥），否则新环境无从复制
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data discipline (PRD 全局约束): 原始聊天样本永不进 git
/samples/raw/

# 本地文件订单存储（ORDERS_DATA_DIR，见 src/lib/order-store-file.ts）
/.data/
